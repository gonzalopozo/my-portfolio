{
	"name": "portfolio-gonzalopozo",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "24.x",
		"pnpm": ">=12.14.0 <13"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"lint:staged": "lint-staged",
		"commitlint": "commitlint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"spellcheck": "cspell lint . --config cspell.json --no-progress",
		"spellcheck:suggestions": "cspell lint . --config cspell.json --no-progress --show-suggestions",
		"knip": "knip",
		"knip:fix": "knip --fix",
		"depcruise": "depcruise app components lib db proxy.ts instrumentation.ts scripts --config .dependency-cruiser.cjs",
		"depcruise:graph": "depcruise app components lib db proxy.ts instrumentation.ts scripts --config .dependency-cruiser.cjs --output-type dot | dot -T svg > dependency-graph.svg",
		"test": "vitest",
		"migrate:generate": "drizzle-kit generate --config ./db/drizzle.config.ts",
		"migrate:push": "tsx scripts/database.mts push",
		"db:setup": "pnpm migrate:generate && pnpm migrate:push",
		"audit": "pnpm audit",
		"audit:fix": "pnpm audit --fix=update",
		"check-updates": "pnpm dlx npm-check-updates",
		"update:latest": "pnpm up --latest",
		"skills:install": "pnpm dlx skills add vercel-labs/skills --skill find-skills -y && pnpm dlx skills add vercel-labs/agent-skills --skill web-design-guidelines --skill vercel-react-best-practices --skill vercel-composition-patterns -y && pnpm dlx skills add vercel-labs/next-skills --skill next-best-practices --skill next-cache-components -y && pnpm dlx skills add anthropics/skills --skill frontend-design -y && pnpm dlx skills add shadcn/ui --skill shadcn -y && pnpm dlx skills add wshobson/agents --skill typescript-advanced-types --skill nextjs-app-router-patterns --skill tailwind-design-system --skill wcag-audit-patterns --skill accessibility-compliance -y && pnpm dlx skills add bobmatnyc/claude-mpm-skills --skill drizzle-orm -y && pnpm dlx skills add better-auth/skills --skill better-auth-best-practices -y && pnpm dlx skills add antfu/skills --skill vitest -y && pnpm dlx skills add currents-dev/playwright-best-practices-skill --skill playwright-best-practices -y && pnpm dlx skills add microsoft/playwright-cli --skill playwright-cli -y && pnpm dlx skills add coreyhaines31/marketingskills --skill seo-audit -y",
		"skills:check": "pnpm dlx skills check",
		"skills:update": "pnpm dlx skills update -y",
		"skills:sync": "pnpm skills:check && pnpm skills:update",
		"icons:manifest": "pnpm tsx scripts/generate-icon-manifest.mts",
		"hooks:install": "pnpm exec husky",
		"prepare": "husky",
		"typecheck": "next typegen && tsc --noEmit",
		"test:run": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:component": "vitest run --project component",
		"test:integration": "vitest run --project integration",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:prod": "tsx scripts/run-production-e2e.mts",
		"test:api": "tsx scripts/run-production-e2e.mts --project api",
		"test:contract": "vitest run --config vitest.contract.config.mts",
		"migrate:apply": "tsx scripts/database.mts apply",
		"migrate:check": "tsx scripts/database.mts check",
		"migrate:baseline": "tsx scripts/database.mts baseline",
		"ci:quality": "tsx scripts/quality.mts",
		"ci:secrets": "node scripts/scan-secrets.mjs",
		"release": "tsx scripts/release.mts",
		"smoke": "tsx scripts/smoke.mts"
	},
	"dependencies": {
		"@dnd-kit/helpers": "^0.3.2",
		"@dnd-kit/react": "^0.3.2",
		"@libsql/client": "^0.17.0",
