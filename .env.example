# Copy to .env.local for development. Never put secret values in committed files.
APP_ENV=development
TURSO_DATABASE_URL=file:./.ci/development.db
TURSO_AUTH_TOKEN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
ADMIN_USER_IDS=
BLOB_PUBLIC_HOSTNAME=https://example.public.blob.vercel-storage.com
BLOB_READ_WRITE_TOKEN=
LASTFM_USERNAME=
LASTFM_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
CSP_PUBLIC_MODE=report-only
CSP_ADMIN_MODE=report-only
CSP_ADMIN_POLICY=static
# Server-only readiness credential, independent in every environment.
HEALTH_READINESS_TOKEN=
# Public DSN is not a secret. Configure the identical DSN for server and browser.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN: production Vercel build only; never Preview or PR CI.
