{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "nextjs",
	"installCommand": "node scripts/install-vercel.mjs",
	"buildCommand": "node scripts/build-vercel.mjs",
	"git": {
		"deploymentEnabled": {
			"main": false,
			"restructure": false
		}
	},
	"crons": [
		{
			"path": "/api/cron/og-images",
			"schedule": "0 3 * * *"
		}
	]
}
